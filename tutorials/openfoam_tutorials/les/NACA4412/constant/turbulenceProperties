FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType LES;

LES
{
    LESModel        kEqn;

    kEqnCoeffs
    {
        Ck          0.094;
        Ce          1.048;
    }

    delta           cubeRootVol;

    turbulence      on;
    printCoeffs     on;
}

