FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  LES;

LES
{
    LESModel        Smagorinsky;

    turbulence      on;

    printCoeffs     on;

    delta           cubeRootVol;

    SmagorinskyCoeffs
    {
        Ck          0.0265463553;
        Ce          1.048;
    }

    cubeRootVolCoeffs
    {
        deltaCoeff  1;
    }
}

