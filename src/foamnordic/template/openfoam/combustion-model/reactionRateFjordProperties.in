FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      combustionProperties;
}

combustionModel @FOAMNORDIC_MODEL@;
active          true;

@FOAMNORDIC_MODEL@Coeffs
{
    progressField          @PROGRESS_FIELD@;
    // Standard reacting solvers do not normally register an external source.
    // The adapter owns it unless a solver has already registered the field.
    reactionRateField      @FOAMNORDIC_OUTPUT_FIELDS@;
    reactionRateBasis      @REACTION_RATE_BASIS@;
    reactionRateDimensions @REACTION_RATE_DIMENSIONS@;
    autoCreateReactionRate true;

    foamNordicClosure
    {
        address          "@FOAMNORDIC_ADDRESS@";
        sessionId        1;
        sharedMemory     @FOAMNORDIC_SHARED_MEMORY@;
        ucx              false;

        inputs
        (
            @FOAMNORDIC_INPUT_KEYS@
        );

        inputExpressions
        (
            @FOAMNORDIC_INPUT_EXPRESSIONS@
        );

        outputs
        (
            @FOAMNORDIC_OUTPUT_FIELDS@
        );

        outputKeys
        (
            @FOAMNORDIC_OUTPUT_KEYS@
        );

        @FOAMNORDIC_OBSERVATION_BLOCK@
    }
}
