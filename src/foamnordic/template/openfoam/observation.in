observation
{
    path        "@FOAMNORDIC_OBSERVATION_PATH@";
    fields      (@FOAMNORDIC_OBSERVATION_FIELDS@);
    every       @FOAMNORDIC_OBSERVATION_EVERY@;
    offset      @FOAMNORDIC_OBSERVATION_OFFSET@;
    maxRecords  @FOAMNORDIC_OBSERVATION_MAX_RECORDS@;
    maxBytes    @FOAMNORDIC_OBSERVATION_MAX_BYTES@;
    overflow    @FOAMNORDIC_OBSERVATION_OVERFLOW@;
}
