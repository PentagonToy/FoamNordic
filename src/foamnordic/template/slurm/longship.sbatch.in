#!/bin/bash
#SBATCH --job-name=@JOB_NAME@
#SBATCH --account=@ACCOUNT@
#SBATCH --partition=@PARTITION@
#SBATCH --time=@TIME_LIMIT@
#SBATCH --nodes=@NODES@
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=@ALLOCATION_CPUS_PER_NODE@
#SBATCH --mem=@MEMORY_PER_NODE@
#SBATCH --output=@OUTPUT_PATH@

set -Eeuo pipefail

@BANNER@

@ENVIRONMENT@

echo "[FoamNordic] Longship job: $SLURM_JOB_ID"
echo "[FoamNordic] Starting one multi-rank ClosureHost per solver node."

exec @LONGSHIP_EXECUTABLE@ \
    @HOST_READY_ARGUMENTS@ \
    --readiness-timeout-ms @READINESS_TIMEOUT_MS@ \
    --termination-grace-ms @TERMINATION_GRACE_MS@ \
    --host \
        srun \
        --nodes=@NODES@ \
        --ntasks=@HOST_TASKS@ \
        --ntasks-per-node=1 \
        --cpus-per-task=@HOST_CPUS_PER_TASK@ \
        --cpu-bind=none \
        --exact \
        --exclusive \
        @HOST_COMMAND@ \
    --solver \
        srun \
        --nodes=@NODES@ \
        --ntasks=@SOLVER_TASKS@ \
        --ntasks-per-node=@SOLVER_TASKS_PER_NODE@ \
        --cpus-per-task=@SOLVER_CPUS_PER_TASK@ \
        --cpu-bind=none \
        --exact \
        --exclusive \
        @SOLVER_COMMAND@
