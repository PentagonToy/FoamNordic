ifeq ($(WM_PROJECT_VERSION),14)
FOAMNORDIC_FOAM_INCLUDES = \
    -DFOAMNORDIC_FOUNDATION \
    -I$(LIB_SRC)/MomentumTransportModels/momentumTransportModels/lnInclude \
    -I$(LIB_SRC)/MomentumTransportModels/incompressible/lnInclude \
    -I$(LIB_SRC)/MomentumTransportModels/compressible/lnInclude \
    -I$(LIB_SRC)/physicalProperties/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/basic/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/specie/lnInclude

FOAMNORDIC_FOAM_LIBS = \
    -lmomentumTransportModels \
    -lincompressibleMomentumTransportModels \
    -lcompressibleMomentumTransportModels \
    -lphysicalProperties \
    -lfluidThermophysicalModels \
    -lspecie
else
FOAMNORDIC_FOAM_INCLUDES = \
    -I$(LIB_SRC)/transportModels \
    -I$(LIB_SRC)/transportModels/compressible/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/turbulenceModels/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/incompressible/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/compressible/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/basic/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/specie/lnInclude

FOAMNORDIC_FOAM_LIBS = \
    -lturbulenceModels \
    -lincompressibleTurbulenceModels \
    -lincompressibleTransportModels \
    -lcompressibleTransportModels \
    -lcompressibleTurbulenceModels \
    -lfluidThermophysicalModels \
    -lspecie
endif

EXE_INC = \
    -std=c++20 \
    -Wno-overloaded-virtual \
    $(FOAMNORDIC_UCX_FLAGS) \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    $(FOAMNORDIC_FOAM_INCLUDES) \
    -I. \
    -Imodels/nutFjord \
    -Imodels/kEqnFjord \
    -Imodels/progressRateFjord \
    -I$(BINDNORDIC_SOURCE_DIR)/include \
    -I$(FOAMNORDIC_SOURCE)/src \
    -I$(FOAMNORDIC_SOURCE)/src/foamnordic/backend/communication/include

LIB_LIBS = \
    -L$(FOAMNORDIC_BUILD)/src/foamnordic/backend/adapter \
    -L$(FOAMNORDIC_BUILD)/src/foamnordic/backend/communication \
    -L$(FOAMNORDIC_BUILD)/src/foamnordic/runtime \
    -lfoamnordic_adapter \
    -lfoamnordic_fjord \
    -lfoamnordic_runtime \
    $(FOAMNORDIC_UCX_LIBS) \
    -lfiniteVolume \
    -lmeshTools \
    $(FOAMNORDIC_FOAM_LIBS)
