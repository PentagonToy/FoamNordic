foamNordicClosure
{
    address          "@FOAMNORDIC_ADDRESS@";
    sessionId        @FOAMNORDIC_SESSION_ID@;
    sharedMemory     @FOAMNORDIC_SHARED_MEMORY@;
    ucx              @FOAMNORDIC_UCX@;

    inputs
    (
        velocity_grad
        filter_width
    );

    inputExpressions
    (
        "grad(U)"
        delta
    );

    outputs
    (
        nut
    );
}
