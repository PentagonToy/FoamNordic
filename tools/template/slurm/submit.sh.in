#!/bin/bash
set -Eeuo pipefail
job_id=""
cancel_job() {
    if [[ -n "$job_id" ]]; then
        scancel "$job_id" 2>/dev/null || true
    fi
    exit 130
}
trap cancel_job INT TERM
for key in $(compgen -e); do
    case "$key" in
        SLURM_*|SBATCH_*|SRUN_*) unset "$key" ;;
    esac
done
raw_job_id=$(sbatch --parsable @BATCH_PATH@)
job_id=${raw_job_id%%;*}
printf '%s\n' "$job_id" > @JOB_FILE@

owner_watchdog=""
watch_owner() {
    local message=""
    if IFS= read -r -u "$FOAMNORDIC_OWNER_FD" message; then
        [[ "$message" == "detach" || "$message" == "complete" ]] && return
    fi
    sleep "${FOAMNORDIC_ORPHAN_TIMEOUT:-30}"
    scancel --signal=KILL "$job_id" 2>/dev/null || true
}
if [[ -n "${FOAMNORDIC_OWNER_FD:-}" ]]; then
    watch_owner &
    owner_watchdog=$!
fi
cleanup_watchdog() {
    if [[ -n "$owner_watchdog" ]]; then
        kill "$owner_watchdog" 2>/dev/null || true
        wait "$owner_watchdog" 2>/dev/null || true
    fi
}
trap cleanup_watchdog EXIT

terminal_state() {
    local target state
    for target in "${job_id}.batch" "$job_id"; do
        state=$(sacct --noheader --parsable2 --jobs "$target" \
            --starttime 1970-01-01 --format=State 2>/dev/null \
            | awk -F'|' 'NF && $1 != "" {print $1; exit}')
        case "$state" in
            COMPLETED*|FAILED*|CANCELLED*|TIMEOUT*|NODE_FAIL*|OUT_OF_ME*|\
            PREEMPTED*|BOOT_FAIL*|DEADLINE*|REVOKED*)
                printf '%s\n' "$state"
                return 0
                ;;
        esac
    done
    return 1
}

state=""
accounting_retries=0
while [[ -z "$state" ]]; do
    state=$(terminal_state || true)
    [[ -n "$state" ]] && break
    if ! squeue --noheader --job "$job_id" 2>/dev/null | grep -q .; then
        accounting_retries=$((accounting_retries + 1))
        if (( accounting_retries >= 60 )); then
            echo "FoamNordic: Slurm accounting did not publish a terminal state" >&2
            exit 1
        fi
    fi
    sleep 1
done
case "$state" in
    COMPLETED*) exit 0 ;;
    CANCELLED*) exit 130 ;;
    *) exit 1 ;;
esac
