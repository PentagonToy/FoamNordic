FoamFile
{
    format          ascii;
    class           dictionary;
    location        "constant";
    object          @MOMENTUM_DICTIONARY@;
}

simulationType  LES;

LES
{
    @LES_MODEL_ENTRY@ @FOAMNORDIC_MODEL@;
    turbulence      on;
@PRINT_COEFFICIENTS@    delta           cubeRootVol;

    cubeRootVolCoeffs
    {
        deltaCoeff      1;
    }

    @FOAMNORDIC_MODEL@Coeffs
    {
        @FOAMNORDIC_MODEL_CONFIGURATION@

        @FOAMNORDIC_MODEL_EXECUTION@
    }
}
